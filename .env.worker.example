# =============================================================================
# KinkTube Local AI Worker
# =============================================================================
# Copy this file to .env.worker and fill DATABASE_URL.
# Do not commit .env.worker.

# Use your production Postgres connection string.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# Local LLM via Ollama.
AI_PROVIDER=ollama
# Recommended models:
# - For 4GB VRAM (GTX 1050): Use "llama3.2:3b" or "dolphin-phi" (fits fully in GPU VRAM, very fast)
# - For 8GB+ VRAM: Use "dolphin3" or "llama3:8b" (high quality but splits to CPU/RAM on lower-end cards)
AI_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Conservative laptop-friendly settings.
AI_SEO_BACKFILL_BATCH_SIZE=1
AI_SEO_BACKFILL_DELAY_MS=5000
AI_SEO_DAILY_TOKEN_BUDGET=0

# Overwrite existing descriptions (re-generate everything from scratch)
# Set to true to replace existing descriptions, false to only process missing ones.
AI_SEO_FORCE_REGENERATE=false

# Disable normal site/import behavior; the worker only generates descriptions.
IMPORT_ENABLED=false
REFRESH_ON_STARTUP=false
AI_SEO_AUTO_BACKFILL=false

# Redis is not required for the AI worker.
REDIS_URL=redis://localhost:6379
