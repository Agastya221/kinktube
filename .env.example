# =============================================================================
# KinkTube Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=kinktube
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=kinktube

# Full connection string (used by backend)
DATABASE_URL=postgres://kinktube:your_secure_password_here@localhost:5432/kinktube?sslmode=disable

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://localhost:6379
# Keep these low on Redis Cloud Essentials/free plans to avoid connection-limit alerts.
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=1

# =============================================================================
# Backend Server Configuration
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# =============================================================================
# Frontend Configuration
# =============================================================================
# API URL accessible from browser (for client-side fetches)
NEXT_PUBLIC_API_URL=http://localhost:8080

# =============================================================================
# CORS / Frontend URL (for backend)
# =============================================================================
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Production URLs (used in docker-compose.prod.yml)
# =============================================================================
# Your domain without trailing slash
SITE_URL=https://kinktube.fun
NEXT_PUBLIC_SITE_URL=https://kinktube.fun
API_URL=https://api.yourdomain.com

# Sitemap generation (used by frontend/scripts/generate-sitemaps.mjs)
SITEMAP_API_URL=http://localhost:8080
SITEMAP_MAX_URLS=10000

# =============================================================================
# Eporner API Configuration
# =============================================================================
EPORNER_BASE_URL=https://www.eporner.com/api/v2
EPORNER_PER_PAGE=100

# =============================================================================
# AI SEO Generation
# =============================================================================
# OpenAI is preferred when OPENAI_API_KEY is set. Generated text is clickable
# adult catalog SEO metadata and is cached in the video description field.
OPENAI_API_KEY=
OPENAI_SEO_MODEL=gpt-4o-mini
AI_SEO_AUTO_BACKFILL=true
AI_SEO_BACKFILL_BATCH_SIZE=25
AI_SEO_BACKFILL_DELAY_MS=750

# Optional fallback/legacy provider. Leave AI_PROVIDER blank for auto-detect.
AI_PROVIDER=
OPENROUTER_API_KEY=
AI_MODEL=meta-llama/llama-3.1-8b-instruct:free

# =============================================================================
# Import/Cron Configuration
# =============================================================================
IMPORT_ENABLED=true
REFRESH_ON_STARTUP=false
# Cron expression: every 4 hours
IMPORT_SCHEDULE=0 */4 * * *
IMPORT_MAX_PAGES=8
LIGHT_IMPORT_MAX_PAGES=2
LIGHT_IMPORT_KEYWORDS=40

# =============================================================================
# Cache Configuration
# =============================================================================
# Cache TTL in seconds (5 minutes default)
CACHE_TTL=300

# =============================================================================
# Ad Network Configuration
# =============================================================================
# Supported networks: exoclick, trafficjunky, juicyads, custom
NEXT_PUBLIC_AD_NETWORK=exoclick

# ExoClick Zone IDs (get from ExoClick dashboard)
NEXT_PUBLIC_AD_ZONE_BANNER=your_banner_zone_id
NEXT_PUBLIC_AD_ZONE_SIDEBAR=your_sidebar_zone_id
NEXT_PUBLIC_AD_ZONE_NATIVE=your_native_zone_id
NEXT_PUBLIC_AD_ZONE_POPUNDER=your_popunder_zone_id
NEXT_PUBLIC_AD_ZONE_VIDEO_BANNER=your_video_banner_zone_id
NEXT_PUBLIC_AD_ZONE_MOBILE_BANNER=your_mobile_banner_zone_id

# =============================================================================
# Affiliate Program IDs
# =============================================================================
# KinkyDollars (Kink.com) - Primary affiliate program
# Sign up at: https://www.kinkydollars.com/
AFFILIATE_KINKYDOLLARS_ID=your_kinkydollars_id

# ClubDomCash (Femdom focused)
# Sign up at: https://www.clubdomcash.com/
AFFILIATE_CLUBDOMCASH_ID=your_clubdomcash_id

# FemDom Empire
AFFILIATE_FEMDOMEMPIRE_ID=your_femdomempire_id

# Device Bondage (Kink.com sub-brand)
AFFILIATE_DEVICEBONDAGE_ID=your_devicebondage_id

# Hogtied (Kink.com sub-brand)
AFFILIATE_HOGTIED_ID=your_hogtied_id

# Whipped Ass (Kink.com sub-brand)
AFFILIATE_WHIPPEDASS_ID=your_whippedass_id

# Sadistic Rope (Kink.com sub-brand)
AFFILIATE_SADISTICROPE_ID=your_sadisticrope_id

# Default/Fallback affiliate ID
AFFILIATE_DEFAULT_ID=your_default_id

# =============================================================================
# Analytics - Umami
# =============================================================================
NEXT_PUBLIC_UMAMI_URL=https://umami-production-7e90.up.railway.app
NEXT_PUBLIC_UMAMI_ID=aa4fb41b-db5b-4886-aed4-42b11f4f9431

# =============================================================================
# Security
# =============================================================================
# Admin API key for protected endpoints (generate a strong random string)
ADMIN_API_KEY=your_secure_admin_api_key_here

# Hidden admin route slug.
# Access format: https://yourdomain.com/portal/<ADMIN_ROUTE_SLUG>
ADMIN_ROUTE_SLUG=control-room

# Admin login credentials for the hidden admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Optional bcrypt hash. If set, it will be used instead of ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=

# =============================================================================
# SSL/TLS (Production)
# =============================================================================
# Path to SSL certificates (for nginx)
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem
